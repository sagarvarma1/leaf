# Copy to .env (cp .env.example .env). Read by `pnpm dev`.

# Port of the API + WebSocket server.
API_PORT=4000
# Port of the Next.js web app.
WEB_PORT=3000
# Where SQLite lives (relative to the repo root).
LEAF_DATA_DIR=data
# Seed the demo workspace (alice@leaf.dev / bob@leaf.dev, password leafdemo) on first run. 0 = off.
LEAF_SEED=1
# Leaf AI: an Anthropic API key enables the AI collaborator (Claude Opus 5.5).
# ANTHROPIC_API_KEY=sk-ant-...
# Or run the scripted demo model instead (no key, no network): LEAF_AI_MOCK=1
# Delay between typed chunks when the AI writes, and runs allowed per user per hour.
# LEAF_AI_TYPING_MS=16
# LEAF_AI_RUNS_PER_HOUR=30
